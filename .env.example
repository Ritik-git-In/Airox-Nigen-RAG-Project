# ---- Kimi / Moonshot AI (the LLM that answers questions) ----
# Get a key from https://platform.moonshot.ai/  (or https://platform.moonshot.cn/ in China)
KIMI_API_KEY=sk-your-kimi-key-here

# International endpoint. Use https://api.moonshot.cn/v1 if your key is from the .cn console.
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Model to use. Good options: kimi-k2-0905-preview, kimi-latest, moonshot-v1-32k, moonshot-v1-128k
KIMI_MODEL=moonshot-v1-32k

# ---- Local embedding model (the "reading" part) ----
# Downloaded automatically on first run. all-MiniLM-L6-v2 is small and fast.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Retrieval / chunking knobs (sensible defaults; tune later) ----
# Characters per chunk and overlap between consecutive chunks.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# How many chunks to retrieve and feed to the model per question.
TOP_K=5
